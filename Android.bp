soong_namespace {
    imports: [
        "vendor/xiaomi/flourite",
        "vendor/xiaomi/flourite-miuicamera",
    ],
}

// A standalone fragment is loaded for both the generic and volcano SKU
// manifests. DEVICE_MANIFEST_FILE alone only changes the generic manifest.
prebuilt_etc_xml {
    name: "manifest_flourite_mivi.xml",
    src: "configs/manifest.xml",
    filename: "manifest_flourite_mivi.xml",
    sub_dir: "vintf/manifest",
    soc_specific: true,
}

android_app_import {
    name: "MiuiCamera",
    owner: "xiaomi",
    apk: ":MiuiCamera-flourite-apk",
    certificate: "platform",
    privileged: true,
    overrides: [
        "Camera",
        "Camera2",
    ],
    optional_uses_libs: [
        "miui-cameraopt",
        "com.android.extensions.appfunctions",
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
    enforce_uses_libs: true,
    dex_preopt: {
        enabled: false,
    },
}
