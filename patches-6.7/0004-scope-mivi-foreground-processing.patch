Subject: [PATCH] flourite: keep pending MIVI captures foreground on AOSP

Use an app-private camera foreground service only while user-initiated captures
are pending. Its implementation is compiled from compat/FlouriteProcessingService.java
and appended as a separate DEX by camera_apk_fixup.py. Existing runtime camera
permissions, AppOps and sensor privacy checks remain in force.

Reject stale receiver callbacks before acquiring/detaching an image from a
closed/error session, including the null-image case. Do not swallow processing
errors from an otherwise live session.

Target: pinned Camera 6.7.000070.0 base (see camera_apk_source.py).

diff --git a/smali_classes5/com/xiaomi/camera/mivi/MIVICaptureManager.smali b/smali_classes5/com/xiaomi/camera/mivi/MIVICaptureManager.smali
--- a/smali_classes5/com/xiaomi/camera/mivi/MIVICaptureManager.smali
+++ b/smali_classes5/com/xiaomi/camera/mivi/MIVICaptureManager.smali
@@ -120,3 +120,13 @@
     invoke-virtual/range {v0 .. v6}, Lcom/xiaomi/camera/mivi/MIVICaptureManagerImpl;->addAll(JLjava/lang/String;Ldi/s;Lcom/xiaomi/camera/mivi/MIVICaptureManager$FinalPictureListener;Ljava/lang/String;)V
 
+    invoke-static {}, Lcom/xiaomi/camera/mivi/MIVISDKConfig;->getInstance()Lcom/xiaomi/camera/mivi/MIVISDKConfig;
+
+    move-result-object v0
+
+    invoke-virtual {v0}, Lcom/xiaomi/camera/mivi/MIVISDKConfig;->getContext()Landroid/content/Context;
+
+    move-result-object v0
+
+    invoke-static {v0}, Lcom/xiaomi/camera/mivi/FlouriteProcessingService;->start(Landroid/content/Context;)V
+
     return-void
diff --git a/smali_classes5/com/xiaomi/camera/mivi/qcom/MockCameraImageReceiver.smali b/smali_classes5/com/xiaomi/camera/mivi/qcom/MockCameraImageReceiver.smali
--- a/smali_classes5/com/xiaomi/camera/mivi/qcom/MockCameraImageReceiver.smali
+++ b/smali_classes5/com/xiaomi/camera/mivi/qcom/MockCameraImageReceiver.smali
@@ -1160,7 +1160,26 @@
 .method private synthetic lambda$createCaptureSession$0(ILandroid/media/ImageReader;)V
     .locals 8
 
+    iget v0, p0, Lcom/xiaomi/camera/mivi/qcom/MockCameraImageReceiver;->mState:I
+
+    const/4 v1, 0x4
+
+    if-lt v0, v1, :flourite_no_image
+
+    iget-object v0, p0, Lcom/xiaomi/camera/mivi/qcom/MockCameraImageReceiver;->mImageReaderList:Ljava/util/List;
+
+    invoke-interface {v0, p2}, Ljava/util/List;->contains(Ljava/lang/Object;)Z
+
+    move-result v0
+
+    if-eqz v0, :flourite_no_image
+
+    :flourite_acquire_start
     invoke-virtual {p2}, Landroid/media/ImageReader;->acquireNextImage()Landroid/media/Image;
 
     move-result-object v0
+    :flourite_acquire_end
+    .catch Ljava/lang/IllegalStateException; {:flourite_acquire_start .. :flourite_acquire_end} :flourite_closed_reader
+
+    if-eqz v0, :flourite_no_image
 
@@ -1244,5 +1263,17 @@
     :cond_0
     invoke-direct {p0, v0, p1}, Lcom/xiaomi/camera/mivi/qcom/MockCameraImageReceiver;->join(Landroid/media/Image;I)V
 
     return-void
+
+    :flourite_closed_reader
+    move-exception v0
+
+    iget-object v1, p0, Lcom/xiaomi/camera/mivi/qcom/MockCameraImageReceiver;->TAG:Ljava/lang/String;
+
+    const-string v2, "Ignoring callback from a closed image reader"
+
+    invoke-static {v1, v2, v0}, Landroid/util/Log;->w(Ljava/lang/String;Ljava/lang/String;Ljava/lang/Throwable;)I
+
+    :flourite_no_image
+    return-void
 .end method
